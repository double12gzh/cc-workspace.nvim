{
	"$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
	"runtime": {
		"version": "LuaJIT",
		"path": [
			"lua/?.lua",
			"lua/?/init.lua",
			"?.lua",
			"?/init.lua"
		]
	},
	"diagnostics": {
		"globals": [
			"vim"
		]
	},
	"workspace": {
		"checkThirdParty": false,
		"ignoreDir": [
			".git",
			".worktrees",
			".claude",
			".omp",
			".pi",
			".luals-log"
		],
		"library": [
			"${env:VIMRUNTIME}"
		]
	},
	"telemetry": {
		"enable": false
	}
}
